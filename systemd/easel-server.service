# The easel's local web server (127.0.0.1:8090, and the remote listener when settings `remote.enabled`).
# systemd USER unit. Install: copy to ~/.config/systemd/user/, set the path, then
#   systemctl --user daemon-reload && systemctl --user enable --now easel-server.service
[Unit]
Description=Easel: local page and JSON (127.0.0.1:8090)
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
# the path to your clone; settings from ~/.config/easel/easel.toml (or set Environment=EASEL_CONFIG=...)
ExecStart=/usr/bin/python3 -I %h/src/easel/server.py
Restart=always
RestartSec=5
Nice=10
MemoryMax=200M
NoNewPrivileges=yes

[Install]
WantedBy=default.target
